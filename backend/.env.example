# --- LLM provider: DeepSeek (never commit real values) ---
DEEPSEEK_API_KEY=
# Bulk work (query expansion, translation, quick search).
DEEPSEEK_MODEL=deepseek-v4-flash
# Deep research and close reading.
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Supabase: database + auth ---
# Settings → Database → Connection string → URI (use the Session pooler one),
# with [YOUR-PASSWORD] replaced by your database password.
DATABASE_URL=
# Settings → API → Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Only for legacy HS256 projects (Settings → API → JWT Secret). Leave empty
# when the project uses the newer asymmetric signing keys.
SUPABASE_JWT_SECRET=

# --- OpenAlex ---
# An email address puts requests in OpenAlex's "polite pool", which has far
# higher rate limits. Without it you share one anonymous pool per IP — on
# shared hosting that pool is exhausted by strangers and lookups start failing
# with 429s that look like "paper not found". Defaults to NCBI_EMAIL.
OPENALEX_MAILTO=

# --- Optional NCBI/PubMed ---
NCBI_API_KEY=
NCBI_TOOL=Gaze
NCBI_EMAIL=

# --- Tuning ---
MAX_RESULTS=18
