# --- LLM provider: DeepSeek (never commit real values) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Supabase: database + auth ---
# Settings → Database → Connection string → URI (use the Session pooler one),
# with [YOUR-PASSWORD] replaced by your database password.
DATABASE_URL=
# Settings → API → Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Only for legacy HS256 projects (Settings → API → JWT Secret). Leave empty
# when the project uses the newer asymmetric signing keys.
SUPABASE_JWT_SECRET=

# --- Optional NCBI/PubMed ---
NCBI_API_KEY=
NCBI_TOOL=Gaze
NCBI_EMAIL=

# --- Tuning ---
MAX_RESULTS=18
